<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youkeda.hashopping.shop.dao.ShopDAO">
 <select id="lockOwnedActive" resultType="java.lang.Long">
